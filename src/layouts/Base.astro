---
import '../styles/global.css';
// Police hébergée avec le site : aucun appel à un service tiers (pas de Google Fonts).
import '@fontsource/space-grotesk/latin-400.css';
import '@fontsource/space-grotesk/latin-500.css';
import '@fontsource/space-grotesk/latin-700.css';

const {
  title = 'Oinarri',
  description = "Formation en ligne pour comprendre le bâtiment, la promotion immobilière et le logement social, en partant de zéro.",
  // Page large : accueil, listes de chapitres et cours (voir global.css).
  large = false,
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Oinarri" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#181715" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('oinarri-theme');
          if (!t) {
            t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <div class:list={['page', { 'page-large': large }]}>
      <header class="entete">
        <a class="logo" href="/" aria-label="Oinarri, accueil">
          <svg class="logo-icon" viewBox="0 0 44 32" fill="none" stroke-width="6" stroke-linecap="round" aria-hidden="true">
            <line class="logo-stroke-1" x1="13" y1="5" x2="31" y2="5" />
            <line class="logo-stroke-2" x1="8" y1="16" x2="36" y2="16" />
            <line class="logo-stroke-3" x1="3" y1="27" x2="41" y2="27" />
          </svg>
          <span class="logo-text">Oinarri</span>
        </a>
        <div class="entete-droite">
          <a class="lien-entete" href="/glossaire/">Glossaire</a>
          <a class="lien-entete lien-notes" href="/notes/">Mes notes</a>
          <a class="lien-entete" href="/compte/">Mon compte</a>
          <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Changer de thème">
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            </svg>
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
            </svg>
          </button>
        </div>
      </header>

      <main>
        <slot />
      </main>

      <footer class="pied">
        Contenus informatifs, fondés sur des sources publiques. Ils ne remplacent ni un avis juridique,
        ni une étude technique, ni un conseil financier.
        <a class="lien-confidentialite" href="/confidentialite/">Confidentialité</a>
      </footer>
    </div>

    <script>
      const bouton = document.getElementById('theme-toggle');
      bouton?.addEventListener('click', () => {
        const racine = document.documentElement;
        const suivant = racine.dataset.theme === 'dark' ? 'light' : 'dark';
        racine.dataset.theme = suivant;
        try {
          localStorage.setItem('oinarri-theme', suivant);
        } catch (e) {}
      });
    </script>
  </body>
</html>

<style>
  .entete-droite {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .lien-entete {
    font-size: 14px;
    color: var(--ink-600);
    text-underline-offset: 3px;
  }

  .lien-entete:hover {
    color: var(--ink-900);
  }

  /* Sur téléphone, la place manque : « Mes notes » est alors accessible depuis le tiroir de notes d'un cours. */
  @media (max-width: 40rem) {
    .lien-notes {
      display: none;
    }
  }

  .lien-confidentialite {
    display: inline-block;
    margin-left: 0.5rem;
    text-underline-offset: 3px;
  }
</style>
