---
import '../styles/global.css';
// Police hébergée avec le site : aucun appel à un service tiers (pas de Google Fonts).
import '@fontsource/space-grotesk/latin-400.css';
import '@fontsource/space-grotesk/latin-500.css';
import '@fontsource/space-grotesk/latin-700.css';
import Entete from '../components/Entete.astro';

const {
  title = 'Oinarri',
  description = "Formation en ligne pour comprendre le bâtiment, la promotion immobilière et le logement social, en partant de zéro.",
  // Page large : accueil, listes de chapitres et cours (voir global.css).
  large = false,
  // Page avec bande de couleur : l'en-tête et le contenu du slot « bande » s'y placent,
  // et le contenu principal commence en la chevauchant.
  bande = false,
  // Étiquette du parcours à côté du logo, par exemple ['PROMO-', 'TION'].
  etiquette = null,
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Oinarri" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#181715" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('oinarri-theme');
          if (!t) {
            t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    {
      bande && (
        <div class="bande">
          <div class:list={['page', { 'page-large': large }, 'bande-interne']}>
            <Entete etiquette={etiquette} />
            <slot name="bande" />
          </div>
        </div>
      )
    }

    <div class:list={['page', { 'page-large': large }, { 'page-sous-bande': bande }]}>
      {!bande && <Entete etiquette={etiquette} />}

      <main>
        <slot />
      </main>

      <footer class="pied">
        Contenus informatifs, fondés sur des sources publiques. Ils ne remplacent ni un avis juridique,
        ni une étude technique, ni un conseil financier.
        <a class="lien-confidentialite" href="/confidentialite/">Confidentialité</a>
      </footer>
    </div>

    <script>
      const bouton = document.getElementById('theme-toggle');
      bouton?.addEventListener('click', () => {
        const racine = document.documentElement;
        const suivant = racine.dataset.theme === 'dark' ? 'light' : 'dark';
        racine.dataset.theme = suivant;
        try {
          localStorage.setItem('oinarri-theme', suivant);
        } catch (e) {}
      });
    </script>
  </body>
</html>

<style>
  .lien-confidentialite {
    display: inline-block;
    margin-left: 0.5rem;
    text-underline-offset: 3px;
  }
</style>
