---
// En-tête commun : logo, étiquette du parcours (facultative) et liens.
// `etiquette` = deux morceaux d'un mot coupé sur deux lignes, par exemple ['PROMO-', 'TION'].
const { etiquette = null } = Astro.props;
---

<header class="entete">
  <div class="lockup">
    <a class="logo" href="/" aria-label="Oinarri, accueil">
      <svg class="logo-icon" viewBox="0 0 44 32" fill="none" stroke-width="6" stroke-linecap="round" aria-hidden="true">
        <line class="logo-stroke-1" x1="13" y1="5" x2="31" y2="5" />
        <line class="logo-stroke-2" x1="8" y1="16" x2="36" y2="16" />
        <line class="logo-stroke-3" x1="3" y1="27" x2="41" y2="27" />
      </svg>
      <span class="logo-text">Oinarri</span>
    </a>
    {
      etiquette && (
        <>
          <span class="filet" aria-hidden="true" />
          <span class="module-tag" aria-hidden="true">
            <span>{etiquette[0]}</span>
            <span>{etiquette[1]}</span>
          </span>
        </>
      )
    }
  </div>
  <div class="entete-droite">
    <a class="lien-entete" href="/glossaire/">Glossaire</a>
    <a class="lien-entete lien-notes" href="/notes/">Mes notes</a>
    <a class="lien-entete" href="/compte/">Mon compte</a>
    <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Changer de thème">
      <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
      </svg>
      <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
      </svg>
    </button>
  </div>
</header>

<style>
  .lockup {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
  }

  .filet {
    flex-shrink: 0;
    width: 2px;
    height: 2.2rem;
    background: var(--ink-600);
  }

  /* Mot coupé sur deux lignes, serré et légèrement incliné. */
  .module-tag {
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    font-size: 15px;
    font-weight: 700;
    line-height: 0.92;
    letter-spacing: -0.3px;
    text-transform: uppercase;
    color: var(--ink-900);
    transform: rotate(-5deg);
    transform-origin: left center;
  }

  .module-tag span:last-child {
    padding-left: 0.9em;
  }

  .entete-droite {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .lien-entete {
    font-size: 14px;
    color: var(--ink-600);
    text-underline-offset: 3px;
  }

  .lien-entete:hover {
    color: var(--ink-900);
  }

  /* Sur téléphone, la place manque : l'étiquette est déjà rappelée dans la bande,
     et « Mes notes » reste accessible depuis le tiroir de notes d'un cours. */
  @media (max-width: 40rem) {
    .lien-notes {
      display: none;
    }
  }

  @media (max-width: 36rem) {
    .filet,
    .module-tag {
      display: none;
    }
  }
</style>
