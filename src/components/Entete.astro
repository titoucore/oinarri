---
// En-tête commun : logo, étiquette du parcours (facultative) et menu.
// `etiquette` = deux morceaux d'un mot coupé sur deux lignes, par exemple ['PROMO-', 'TION'].
//
// Le menu regroupe tous les accès de l'application en quatre groupes, identiques partout :
// Parcours (apprendre), Outils (manipuler), Ressources (consulter), Mon espace (ma progression).
// Pour ajouter une page, on l'ajoute dans GROUPES ci-dessous : elle apparaît dans le menu de toutes les pages.
const { etiquette = null } = Astro.props;
const chemin = Astro.url.pathname;

const GROUPES = [
  {
    titre: 'Parcours',
    liens: [
      { href: '/ba-ba/', libelle: 'B.A.-BA du bâtiment' },
      { href: '/promotion/', libelle: 'Promotion immobilière' },
      { href: '/logement-social/', libelle: 'Logement social' },
      { href: '/materiaux-biosources/', libelle: 'Nouvelles méthodes de construction' },
    ],
  },
  {
    titre: 'Outils',
    liens: [
      { href: '/simulateur/', libelle: 'Simulateur de bilan' },
      { href: '/comparateur/', libelle: 'Comparateur de matériaux' },
    ],
  },
  {
    titre: 'Ressources',
    liens: [
      { href: '/glossaire/', libelle: 'Glossaire' },
      { href: '/chiffres-cles/', libelle: 'Chiffres clés' },
      { href: '/infographies/', libelle: 'Infographies' },
    ],
  },
  {
    titre: 'Mon espace',
    liens: [
      { href: '/revisions/', libelle: 'Révisions' },
      { href: '/notes/', libelle: 'Mes notes' },
      { href: '/compte/', libelle: 'Mon compte' },
      // Visible seulement pour un administrateur (révélé par le script ci-dessous).
      { href: '/admin/', libelle: 'Administration', admin: true },
    ],
  },
];

const actif = (href) => chemin === href || chemin.startsWith(href);
---

<header class="entete">
  <div class="lockup">
    <a class="logo" href="/" aria-label="Oinarri, accueil">
      <svg class="logo-icon" viewBox="0 0 44 32" fill="none" stroke-width="6" stroke-linecap="round" aria-hidden="true">
        <line class="logo-stroke-1" x1="13" y1="5" x2="31" y2="5" />
        <line class="logo-stroke-2" x1="8" y1="16" x2="36" y2="16" />
        <line class="logo-stroke-3" x1="3" y1="27" x2="41" y2="27" />
      </svg>
      <span class="logo-text">Oinarri</span>
    </a>
    {
      etiquette && (
        <>
          <span class="filet" aria-hidden="true" />
          <span class="module-tag" aria-hidden="true">
            <span>{etiquette[0]}</span>
            <span>{etiquette[1]}</span>
          </span>
        </>
      )
    }
  </div>
  <div class="entete-droite">
    <button
      class="menu-bouton"
      id="menu-bouton"
      type="button"
      aria-expanded="false"
      aria-controls="menu-panneau"
    >
      <svg class="menu-icone" viewBox="0 0 22 16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
        <line x1="7" y1="3" x2="15" y2="3" />
        <line x1="4" y1="8" x2="18" y2="8" />
        <line x1="1.5" y1="13" x2="20.5" y2="13" />
      </svg>
      <span>Menu</span>
    </button>
    <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Changer de thème">
      <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
      </svg>
      <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
      </svg>
    </button>
  </div>

  <div class="menu-panneau" id="menu-panneau" hidden>
    <nav aria-label="Menu principal">
      <div class="menu-groupes">
        {
          GROUPES.map((groupe) => (
            <section class="menu-groupe">
              <h2 class="menu-titre">{groupe.titre}</h2>
              <ul class="menu-liste">
                {groupe.liens.map((lien) => (
                  <li id={lien.admin ? 'menu-admin' : undefined} hidden={lien.admin ? true : undefined}>
                    <a href={lien.href} aria-current={actif(lien.href) ? 'page' : undefined}>
                      {lien.libelle}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </nav>
  </div>
</header>

<style>
  .entete {
    position: relative;
  }

  .lockup {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
  }

  .filet {
    flex-shrink: 0;
    width: 2px;
    height: 2.2rem;
    background: var(--ink-600);
  }

  /* Mot coupé sur deux lignes, serré et légèrement incliné. */
  .module-tag {
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    font-size: 15px;
    font-weight: 700;
    line-height: 0.92;
    letter-spacing: -0.3px;
    text-transform: uppercase;
    color: var(--ink-900);
    transform: rotate(-5deg);
    transform-origin: left center;
  }

  .module-tag span:last-child {
    padding-left: 0.9em;
  }

  .entete-droite {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  /* Le bouton reprend la hauteur et le trait du bouton de thème, et l'icône reprend les trois
     traits décroissants du logo. */
  .menu-bouton {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 34px;
    padding: 0 14px 0 12px;
    font-family: inherit;
    font-size: 14px;
    font-weight: 500;
    border: 1px solid var(--ink-200);
    border-radius: 999px;
    background: none;
    color: var(--ink-900);
    cursor: pointer;
  }

  .menu-bouton[aria-expanded='true'] {
    border-color: var(--ink-900);
  }

  .menu-icone {
    width: 18px;
    height: auto;
  }

  .menu-panneau {
    position: absolute;
    top: calc(100% + 0.75rem);
    right: 0;
    z-index: 50;
    width: min(46rem, 100%);
    max-height: calc(100vh - 7rem);
    overflow-y: auto;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--ink-100);
    border-radius: 12px;
    background: var(--paper);
  }

  .menu-groupes {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 34rem) {
    .menu-groupes {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 48rem) {
    .menu-groupes {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
  }

  .menu-titre {
    margin: 0 0 0.25rem;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--ink-600);
  }

  .menu-liste {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .menu-liste a {
    display: flex;
    align-items: center;
    min-height: 40px;
    font-size: 15px;
    line-height: 1.3;
    color: var(--ink-900);
    text-decoration: none;
  }

  .menu-liste a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .menu-liste a[aria-current='page'] {
    font-weight: 700;
  }

  @media (max-width: 36rem) {
    .filet,
    .module-tag {
      display: none;
    }
  }
</style>

<script>
  const bouton = document.getElementById('menu-bouton');
  const panneau = document.getElementById('menu-panneau');
  let adminVerifie = false;

  // Le lien « Administration » n'apparaît que pour un administrateur. La vérification se fait
  // à la première ouverture du menu, pour ne pas ajouter une requête à chaque page.
  async function reveleAdmin() {
    if (adminVerifie) return;
    adminVerifie = true;
    try {
      const reponse = await fetch('/api/moi');
      if (!reponse.ok) return;
      const moi = await reponse.json();
      const entree = document.getElementById('menu-admin');
      if (moi && moi.admin && entree) entree.hidden = false;
    } catch {
      // sans réponse, le lien reste masqué
    }
  }

  function ouvrir() {
    panneau.hidden = false;
    bouton.setAttribute('aria-expanded', 'true');
    reveleAdmin();
  }

  function fermer(rendreLeFocus = false) {
    panneau.hidden = true;
    bouton.setAttribute('aria-expanded', 'false');
    if (rendreLeFocus) bouton.focus();
  }

  if (bouton && panneau) {
    bouton.addEventListener('click', () => (panneau.hidden ? ouvrir() : fermer()));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panneau.hidden) fermer(true);
    });
    document.addEventListener('click', (e) => {
      if (panneau.hidden) return;
      if (panneau.contains(e.target) || bouton.contains(e.target)) return;
      fermer();
    });
  }
</script>
