---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const cours = await getCollection('cours', ({ data }) => data.parcours === 'ba-ba');
  return cours.map((entry) => ({
    params: { slug: entry.id.replace('ba-ba/', '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { titre, description, niveau, verifie_le } = entry.data;
const date = verifie_le.toLocaleDateString('fr-FR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<Base title={`${titre} — Oinarri`} description={description}>
  <a class="retour" href="/ba-ba/">B.A.-BA du bâtiment</a>
  <h1>{titre}</h1>
  <p class="meta">
    <span class="etiquette">{niveau}</span>
    <span>Dernière vérification : {date}</span>
  </p>
  <article class="cours">
    <Content />
  </article>
</Base>

<style is:global>
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--ink-600);
    margin: 0 0 2rem;
  }

  .cours {
    font-size: 16px;
    line-height: 1.7;
  }

  .cours h2 {
    font-size: 1.4rem;
    letter-spacing: -0.3px;
    margin: 2.5rem 0 0.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--ink-100);
  }

  .cours h2:first-child {
    border-top: 0;
    padding-top: 0;
    margin-top: 0;
  }

  .cours h3 {
    font-size: 1.05rem;
    font-weight: 700;
    margin: 1.75rem 0 0.5rem;
  }

  .cours p {
    margin: 0 0 1rem;
  }

  .cours ul,
  .cours ol {
    margin: 0 0 1rem;
    padding-left: 1.4rem;
  }

  .cours li {
    margin-bottom: 0.5rem;
  }

  .cours li::marker {
    color: var(--ink-400);
  }

  .cours strong {
    font-weight: 700;
  }

  .cours img {
    display: block;
    width: 100%;
    height: auto;
    margin: 1.5rem 0;
    border-radius: 12px;
  }

  .cours a {
    text-underline-offset: 3px;
  }
</style>
