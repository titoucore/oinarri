---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const cours = await getCollection('cours', ({ data }) => data.parcours === 'ba-ba');
  return cours.map((entry) => ({
    params: { slug: entry.id.replace('ba-ba/', '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { titre, description, niveau, verifie_le } = entry.data;
const date = verifie_le.toLocaleDateString('fr-FR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

// Mini-quiz du chapitre (même identifiant que le cours), transmis au navigateur en JSON.
const quiz = await getEntry('quiz', entry.id);
const quizJson = JSON.stringify(quiz?.data ?? {}).replace(/</g, '\\u003c');
---

<Base title={`${titre} — Oinarri`} description={description}>
  <a class="retour" href="/ba-ba/">B.A.-BA du bâtiment</a>
  <h1>{titre}</h1>
  <p class="meta">
    <span class="etiquette">{niveau}</span>
    <span>Dernière vérification : {date}</span>
  </p>
  <article class="cours" data-cours={entry.id}>
    <Content />
  </article>
  <script is:inline type="application/json" id="quiz-data" set:html={quizJson} />
</Base>

<style is:global>
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--ink-600);
    margin: 0 0 2rem;
  }

  .cours {
    font-size: 16px;
    line-height: 1.7;
  }

  .cours h2 {
    font-size: 1.4rem;
    letter-spacing: -0.3px;
    margin: 2.5rem 0 0.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--ink-100);
  }

  .cours h2:first-child {
    border-top: 0;
    padding-top: 0;
    margin-top: 0;
  }

  .cours h3 {
    font-size: 1.05rem;
    font-weight: 700;
    margin: 1.75rem 0 0.5rem;
  }

  .cours p {
    margin: 0 0 1rem;
  }

  .cours ul,
  .cours ol {
    margin: 0 0 1rem;
    padding-left: 1.4rem;
  }

  .cours li {
    margin-bottom: 0.5rem;
  }

  .cours li::marker {
    color: var(--ink-400);
  }

  .cours strong {
    font-weight: 700;
  }

  .cours img {
    display: block;
    width: 100%;
    height: auto;
    margin: 1.5rem 0;
    border-radius: 12px;
  }

  .cours a {
    text-underline-offset: 3px;
  }

  /* --- Mini-quiz (inséré par le script) --- */

  .cours .quiz {
    margin: 2rem 0 0;
    padding: 1rem;
    border: 1px solid var(--ink-200);
    border-radius: 12px;
    font-size: 15px;
    line-height: 1.6;
  }

  .quiz .quiz-titre {
    font-weight: 700;
    font-size: 16px;
    margin: 0 0 0.25rem;
  }

  .quiz .quiz-info {
    font-size: 14px;
    color: var(--ink-600);
    margin: 0 0 0.75rem;
  }

  .quiz .quiz-progression {
    font-size: 13px;
    color: var(--ink-600);
    margin: 0 0 0.5rem;
  }

  .quiz .quiz-enonce {
    font-weight: 500;
    margin: 0 0 0.9rem;
  }

  .quiz .quiz-score {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 0.25rem;
  }

  .quiz .quiz-liste {
    font-size: 14px;
    color: var(--ink-600);
    margin: 0 0 0.75rem;
  }

  .quiz .quiz-choix {
    display: block;
    width: 100%;
    text-align: left;
    font-family: inherit;
    font-size: 15px;
    line-height: 1.5;
    padding: 10px 12px;
    margin: 0 0 8px;
    border: 1px solid var(--ink-200);
    border-radius: 8px;
    background: var(--paper);
    color: var(--ink-900);
    cursor: pointer;
  }

  .quiz .quiz-choix:disabled {
    cursor: default;
  }

  .quiz .quiz-choix[data-etat='juste'] {
    border: 2px solid var(--ink-900);
    font-weight: 500;
  }

  .quiz .quiz-choix[data-etat='faux'] {
    border-style: dashed;
    color: var(--ink-600);
  }

  .quiz textarea {
    display: block;
    width: 100%;
    font-family: inherit;
    font-size: 15px;
    padding: 9px 11px;
    margin: 0 0 0.75rem;
    border: 1px solid var(--ink-200);
    border-radius: 8px;
    background: var(--paper);
    color: var(--ink-900);
    resize: vertical;
  }

  .quiz .quiz-retour {
    margin: 0.75rem 0;
    padding: 0.75rem 0.9rem;
    border-left: 3px solid var(--ink-900);
    border-radius: 0 8px 8px 0;
    background: var(--ink-50);
    font-size: 15px;
  }

  .quiz .quiz-retour[hidden] {
    display: none;
  }

  .quiz .quiz-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .quiz .quiz-bouton {
    font-family: inherit;
    font-weight: 500;
    font-size: 14px;
    padding: 9px 18px;
    border-radius: 8px;
    border: 1px solid var(--ink-900);
    background: var(--ink-900);
    color: var(--paper);
    cursor: pointer;
  }

  .quiz .quiz-bouton-secondaire {
    background: none;
    color: var(--ink-900);
  }

  /* --- Validation d'un niveau (insérée par le script) --- */

  .validation {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    margin: 1rem 0 0;
    padding: 0.9rem 1rem;
    border: 1px dashed var(--ink-200);
    border-radius: 12px;
  }

  .validation[data-acquis='true'] {
    border-style: solid;
    border-color: var(--ink-900);
  }

  .validation-texte {
    flex: 1;
    min-width: 12rem;
    margin: 0 !important;
    font-size: 14px;
    color: var(--ink-600);
  }

  .validation[data-acquis='true'] .validation-texte {
    color: var(--ink-900);
    font-weight: 500;
  }

  .validation-bouton {
    font-family: inherit;
    font-weight: 500;
    font-size: 14px;
    padding: 9px 18px;
    border-radius: 8px;
    border: none;
    background: var(--ink-900);
    color: var(--paper);
    cursor: pointer;
  }

  .validation-annuler {
    font-family: inherit;
    font-size: 13px;
    padding: 4px;
    border: none;
    background: none;
    color: var(--ink-600);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .validation button:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .validation-erreur {
    flex-basis: 100%;
    margin: 0 !important;
    font-size: 13px;
    font-weight: 500;
  }
</style>

<script>
  import '../../scripts/chapitre.js';
</script>
