---
import Base from '../../layouts/Base.astro';
import { chapitres } from '../../data/materiaux-biosources.js';
---

<Base
  title="Nouvelles méthodes de construction — Oinarri"
  large
  bande
  etiquette={['MATÉ-', 'RIAUX']}
>
  <Fragment slot="bande">
    <a class="retour" href="/">Accueil</a>
    <p class="chiffre-evide" aria-hidden="true">04</p>
    <h1>Nouvelles méthodes de construction</h1>
    <p class="lead">
      Matériaux biosourcés et géosourcés, réemploi, et nouvelles façons de construire et d'habiter.
      La Résidence Arbola sert de fil rouge, dans une version biosourcée comparée au béton.
    </p>
  </Fragment>

  <ol class="chapitres">
    {
      chapitres.map((c) => (
        <li class="chapitre" data-cours={c.cours}>
          <div class="chapitre-corps">
            <p class="chapitre-titre">
              {c.href ? <a class="chapitre-lien" href={c.href}>{c.titre}</a> : c.titre}
            </p>
            <p class="chapitre-desc">{c.desc}</p>
          </div>
          {c.href ? (
            <span class="etiquette etiquette-ok">Disponible</span>
          ) : (
            <span class="etiquette">À venir</span>
          )}
        </li>
      ))
    }
  </ol>

  <aside class="outil" aria-labelledby="t-outil">
    <h2 id="t-outil">Comparateur de matériaux</h2>
    <p>
      Mets côte à côte deux ou trois matériaux et calcule l'épaisseur nécessaire pour une résistance
      thermique donnée, avec les sources de chaque valeur.
    </p>
    <a class="outil-lien" href="/comparateur/">Ouvrir le comparateur</a>
  </aside>
</Base>

<style>
  .chapitre-lien {
    text-decoration: none;
  }

  .etiquette-ok {
    border-style: solid;
    border-color: var(--ink-900);
    color: var(--ink-900);
  }

  .outil {
    margin-top: 2rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--ink-100);
    border-radius: 12px;
  }

  .outil h2 {
    margin: 0 0 0.4rem;
    font-size: 1.15rem;
  }

  .outil p {
    margin: 0 0 0.6rem;
    max-width: var(--lecture-w);
    color: var(--ink-800);
  }

  .outil-lien {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 500;
    text-underline-offset: 3px;
  }
</style>

<script>
  import { chargerProgression, libelleEtat } from '../../scripts/progression.js';

  async function afficherAvancement() {
    const progression = await chargerProgression();
    if (!progression) return;
    for (const element of document.querySelectorAll('li[data-cours]')) {
      const texte = libelleEtat(progression.get(element.dataset.cours));
      const etiquette = element.querySelector('.etiquette');
      if (texte && etiquette) etiquette.textContent = texte;
    }
  }

  afficherAvancement();
</script>
