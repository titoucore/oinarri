---
import Base from '../layouts/Base.astro';
import * as baba from '../data/ba-ba.js';
import * as promotion from '../data/promotion.js';
import { listerCartes } from '../lib/cartes.js';

// Les parcours affichés sur l'accueil, dans l'ordre.
const parcours = [
  { titre: 'B.A.-BA du bâtiment', href: '/ba-ba/', plan: baba },
  { titre: 'Promotion immobilière', href: '/promotion/', plan: promotion },
].map((p) => {
  const dispo = p.plan.disponibles.length;
  return {
    titre: p.titre,
    href: p.href,
    etat: `${dispo} chapitre${dispo > 1 ? 's' : ''} disponible${dispo > 1 ? 's' : ''} sur ${p.plan.chapitres.length}`,
    chapitres: p.plan.disponibles,
  };
});

// Seuls les chapitres disponibles servent à « reprendre où on en est ».
const chapitresDisponibles = parcours.flatMap((p) =>
  p.chapitres.map((c) => ({ titre: c.titre, href: c.href, cours: c.cours })),
);

// Identifiants des cartes de révision existantes (pour ignorer d'éventuelles cartes orphelines).
const idsCartes = (await listerCartes()).map((c) => c.carte);
---

<Base title="Oinarri — comprendre le bâtiment" large bande>
  <Fragment slot="bande">
    <!-- Salutation ou question du prénom : révélées par accueil.js quand les données sont reçues. -->
    <div class="perso" id="perso" hidden>
      <p class="salut" id="salut" hidden></p>
      <form class="form-prenom" id="form-prenom" hidden>
        <label for="prenom">Comment t'appelles-tu ?</label>
        <div class="ligne">
          <input
            id="prenom"
            name="prenom"
            type="text"
            maxlength="40"
            autocomplete="given-name"
            required
          />
          <button type="submit">Enregistrer</button>
        </div>
        <p class="erreur" id="erreur-prenom" role="alert" hidden></p>
      </form>
    </div>

    <div class="assises" aria-hidden="true">
      <div class="assise assise-1"></div>
      <div class="assise assise-2"></div>
      <div class="assise assise-3"></div>
    </div>

    <h1 class="accueil-titre">Comprendre le bâtiment, des fondations à la toiture</h1>
    <p class="lead">
      Une formation en ligne pour adultes, qui part de zéro : qui construit, comment, avec quelles
      règles et à quel prix.
    </p>
  </Fragment>

  <section id="accueil">
    <!-- Le contenu reste invisible tant que les données personnelles n'ont pas été reçues,
         puis apparaît d'un coup. Filet de sécurité : au bout de 2,5 s, on l'affiche quand même. -->
    <script is:inline>
      (function () {
        var s = document.getElementById('accueil');
        s.classList.add('attente');
        setTimeout(function () {
          s.classList.remove('attente');
        }, 2500);
      })();
    </script>

    <a
      class="reprise"
      id="reprise"
      href="#parcours"
      data-chapitres={JSON.stringify(chapitresDisponibles)}
      hidden
    >
      <span class="reprise-etiquette">Reprendre où tu en es</span>
      <span class="reprise-titre" id="reprise-titre"></span>
      <span class="reprise-etat" id="reprise-etat"></span>
    </a>

    <a
      class="revision-lien"
      id="revision-lien"
      href="/revisions/"
      data-cartes={JSON.stringify(idsCartes)}
      hidden
    >
      <span class="reprise-etiquette">Révisions</span>
      <span class="reprise-titre" id="revision-texte"></span>
    </a>

    <nav class="parcours" id="parcours" aria-label="Parcours de formation">
      {
        parcours.map((p) => (
          <a class="parcours-lien" href={p.href}>
            <span class="parcours-titre">{p.titre}</span>
            <span class="parcours-etat">{p.etat}</span>
          </a>
        ))
      }
    </nav>

    <a class="outil-lien" href="/simulateur/">
      <span class="parcours-titre">Simulateur de bilan</span>
      <span class="parcours-etat">
        Fais varier le prix, le terrain ou le crédit et vois la marge d'une opération se recalculer.
      </span>
    </a>

    <p class="note">
      Chaque cours part d'un cas concret, se lit à trois niveaux (essentiel, approfondir, expert) et
      se termine par un quiz pour vérifier ce que tu retiens.
    </p>
  </section>
</Base>

<style>
  /* Les cartes de l'accueil débordent de la bande de couleur. */
  #accueil {
    position: relative;
    z-index: 1;
    margin-top: calc(-1 * var(--chevauche));
    transition: opacity 0.25s ease;
  }
  #accueil.attente {
    opacity: 0;
  }

  .accueil-titre {
    max-width: 15em;
  }

  .perso {
    margin-bottom: 2rem;
  }
  .salut {
    margin: 0;
    font-size: 15px;
    color: var(--ink-600);
  }
  .form-prenom {
    max-width: 34rem;
  }
  .form-prenom label {
    display: block;
    font-size: 14px;
    font-weight: 500;
    margin-bottom: 6px;
  }
  .ligne {
    display: flex;
    gap: 8px;
  }
  .ligne input {
    flex: 1;
    min-width: 0;
    padding: 9px 11px;
    font-family: inherit;
    font-size: 16px;
    border: 1px solid var(--ink-200);
    border-radius: 8px;
    background: var(--paper);
    color: var(--ink-900);
  }
  .ligne button {
    font-family: inherit;
    font-weight: 500;
    font-size: 14px;
    padding: 9px 18px;
    border-radius: 8px;
    border: none;
    background: var(--ink-900);
    color: var(--paper);
    cursor: pointer;
  }
  .ligne button:disabled {
    opacity: 0.5;
  }
  .erreur {
    margin: 6px 0 0;
    font-size: 13px;
    color: var(--ink-900);
    font-weight: 500;
  }

  .reprise,
  .revision-lien {
    display: block;
    max-width: 34rem;
    margin: 0 0 1.25rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--ink-900);
    border-radius: 12px;
    background: var(--paper);
    text-decoration: none;
  }
  .revision-lien {
    border-color: var(--ink-200);
  }
  .reprise[hidden],
  .revision-lien[hidden] {
    display: none;
  }
  .reprise-etiquette {
    display: block;
    font-size: 12px;
    color: var(--ink-600);
  }
  .reprise-titre {
    display: block;
    font-weight: 700;
    font-size: 17px;
    margin-top: 2px;
  }
  .reprise-etat {
    display: block;
    font-size: 14px;
    color: var(--ink-600);
    margin-top: 2px;
  }

  .parcours {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 10px;
    max-width: 48rem;
    margin: 0 0 1rem;
  }
  .parcours-lien,
  .outil-lien {
    display: block;
    padding: 0.9rem 1rem;
    border: 1px solid var(--ink-200);
    border-radius: 12px;
    background: var(--paper);
    text-decoration: none;
  }
  .outil-lien {
    max-width: 48rem;
    margin: 0 0 1.5rem;
    border-style: dashed;
  }
  .parcours-lien:hover,
  .parcours-lien:focus-visible,
  .outil-lien:hover,
  .outil-lien:focus-visible {
    border-color: var(--ink-900);
  }
  .parcours-titre {
    display: block;
    font-weight: 700;
    font-size: 17px;
  }
  .parcours-etat {
    display: block;
    font-size: 14px;
    color: var(--ink-600);
    margin-top: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    #accueil {
      transition: none;
    }
  }
</style>

<script>
  import '../scripts/accueil.js';
</script>
