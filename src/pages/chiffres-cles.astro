---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

// Titres des chapitres, transmis au navigateur pour les liens de chaque chiffre.
const cours = await getCollection('cours');
const titres = Object.fromEntries(cours.map((c) => [c.id, c.data.titre]));
const titresJson = JSON.stringify(titres).replace(/</g, '\\u003c');
---

<Base
  large
  title="Chiffres clés — Oinarri"
  description="Les chiffres du cours en un seul endroit : taux, seuils, durées et exigences, avec leurs sources, leur date de vérification et un export CSV."
>
  <a class="retour" href="/">Accueil</a>
  <h1>Chiffres clés</h1>
  <p class="cc-intro">
    Les taux, seuils et durées cités dans le cours, rassemblés avec leur source et leur date de
    vérification. Un chiffre marqué « À revérifier » a dépassé le délai de validité prévu pour son
    type. « À confirmer » signale une source unique ou un texte que je n'ai pas pu relire.
  </p>

  <script id="cc-titres" type="application/json" set:html={titresJson} />

  <div id="chiffres" class="cc">
    <noscript>
      <p class="cc-noscript">Cette page a besoin de JavaScript pour fonctionner.</p>
    </noscript>

    <div class="cc-filtres">
      <label for="cc-recherche">Rechercher un chiffre</label>
      <input id="cc-recherche" type="search" autocomplete="off" placeholder="Livret A, 53 dB, ascenseur…" />
      <div id="cc-themes" class="cc-puces" role="group" aria-label="Thèmes"></div>
      <label class="cc-case" for="cc-attention">
        <input id="cc-attention" type="checkbox" />
        Seulement ce qui est à revérifier, à confirmer ou à l'état de projet
      </label>
    </div>

    <div class="cc-actions">
      <p id="cc-compte" class="cc-compte" role="status" aria-live="polite"></p>
      <button id="cc-csv" class="cc-bouton" type="button">Télécharger la sélection (CSV)</button>
      <button id="cc-imprimer" class="cc-bouton cc-bouton-secondaire" type="button">
        Imprimer ou enregistrer en PDF
      </button>
    </div>

    <ul id="cc-liste" class="cc-liste"></ul>
  </div>
</Base>

<style is:global>
  .cc-intro {
    max-width: var(--lecture-w);
    color: var(--ink-800);
  }

  #chiffres [hidden] {
    display: none !important;
  }

  .cc-noscript {
    padding: 0.7rem 0.9rem;
    border-left: 3px solid var(--ink-900);
    background: var(--ink-50);
  }

  .cc-filtres {
    margin: 0 0 1rem;
    padding: 1rem;
    border: 1px solid var(--ink-100);
    border-radius: 12px;
  }

  #chiffres label {
    display: block;
    font-size: 14px;
    font-weight: 500;
  }

  #cc-recherche {
    width: 100%;
    min-height: 44px;
    margin: 0.25rem 0 0.75rem;
    padding: 8px 10px;
    font-family: inherit;
    font-size: 16px;
    border: 1px solid var(--ink-200);
    border-radius: 8px;
    background: var(--paper);
    color: var(--ink-900);
  }

  .cc-puces {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 0.75rem;
  }

  .cc-puce {
    min-height: 44px;
    padding: 8px 14px;
    font-family: inherit;
    font-size: 14px;
    font-weight: 500;
    border: 1px solid var(--ink-200);
    border-radius: var(--radius);
    background: none;
    color: var(--ink-900);
    cursor: pointer;
  }

  .cc-puce[aria-pressed='true'] {
    background: var(--ink-900);
    border-color: var(--ink-900);
    color: var(--paper);
  }

  #chiffres label.cc-case {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    font-weight: 400;
  }

  .cc-case input {
    width: 20px;
    height: 20px;
  }

  .cc-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin: 0 0 1rem;
  }

  .cc-compte {
    flex: 1 1 100%;
    margin: 0;
    font-size: 14px;
    color: var(--ink-600);
  }

  .cc-bouton {
    min-height: 44px;
    padding: 9px 18px;
    font-family: inherit;
    font-weight: 500;
    font-size: 14px;
    border-radius: 8px;
    border: 1px solid var(--ink-900);
    background: var(--ink-900);
    color: var(--paper);
    cursor: pointer;
  }

  .cc-bouton-secondaire {
    background: none;
    color: var(--ink-900);
  }

  .cc-liste {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 48rem) {
    .cc-liste {
      grid-template-columns: repeat(2, 1fr);
      align-items: start;
    }
  }

  .cc-carte {
    padding: 1rem;
    border: 1px solid var(--ink-100);
    border-radius: 12px;
    min-width: 0;
  }

  .cc-theme {
    margin: 0 0 0.2rem;
    font-size: 12px;
    font-weight: 700;
    color: var(--ink-600);
  }

  .cc-libelle {
    margin: 0 0 0.5rem;
    font-size: 1rem;
    line-height: 1.35;
  }

  .cc-valeur {
    margin: 0 0 0.4rem;
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.3px;
    line-height: 1.25;
    word-break: break-word;
  }

  .cc-unite,
  .cc-contexte,
  .cc-source,
  .cc-chapitres {
    margin: 0 0 0.4rem;
    font-size: 14px;
  }

  .cc-unite,
  .cc-source {
    color: var(--ink-600);
  }

  .cc-source a,
  .cc-chapitres a {
    text-underline-offset: 3px;
    word-break: break-word;
  }

  .cc-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 0 0 0.5rem;
    padding: 0;
  }

  .cc-badge {
    padding: 1px 10px;
    border: 1px solid var(--ink-400);
    border-radius: 999px;
    font-size: 12px;
    color: var(--ink-600);
  }

  .cc-badge-attention {
    border: 1px dashed var(--ink-900);
    color: var(--ink-900);
    font-weight: 700;
  }

  @media print {
    .cc-filtres,
    .cc-actions,
    .retour {
      display: none !important;
    }
    .cc-liste {
      display: block;
    }
    .cc-carte {
      break-inside: avoid;
      margin-bottom: 0.75rem;
    }
  }
</style>

<script>
  import '../scripts/chiffres-cles.js';
</script>
