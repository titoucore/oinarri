{
  "name": "oinarri",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB_OINARRI",
      "database_name": "oinarri-db",
      "database_id": "c12fd79d-f9f0-431c-a739-2ebea76be9dd"
    }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "e-t-i-k-a.cloudflareaccess.com",
    "ACCESS_AUD": "55aeb6179b058585ed736ed19713c93bcf4d8232e57a2857dd7e892bef310a32"
  },
  "observability": { "enabled": true }
}
